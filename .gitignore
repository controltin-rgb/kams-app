# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
generated/

# playwright
/e2e/.auth/
/test-results/
/playwright-report/

# uploaded files (3D Office models in storage/3dmodels are part of the app)
/storage/*
!/storage/3dmodels/
/.next-e2e/
*.dump

# ---- Not needed to build/run on Vercel (kept locally only) ----
# tests
/tests/
/e2e/
/playwright.config.ts
/vitest.config.ts
# project notes / AI context
/CLAUDE.md
/CLAUDE_project1.md
/AGENTS.md
/IMPLEMENTATION.md
/docs/
# container deployment (Coolify / Podman)
/Dockerfile
/compose.yaml
