{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm prisma generate && pnpm build",
  "crons": [
    { "path": "/api/cron/pm", "schedule": "0 20 * * *" },
    { "path": "/api/cron/notify", "schedule": "0 1 * * *" }
  ]
}
